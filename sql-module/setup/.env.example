# Database Configuration for SQL Training Module
# Copy this file to .env and update with your values

# MySQL Connection Settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=sql_training

# Test User Credentials (for restricted access testing)
TEST_DB_USER=testuser
TEST_DB_PASSWORD=testpass123

# Application Settings
NODE_ENV=development
LOG_LEVEL=info

# Test Configuration
TEST_TIMEOUT=60000
PARALLEL_TESTS=5
CLEANUP_TEST_DATA=true

# Performance Testing
PERF_TEST_ITERATIONS=100
PERF_TEST_CONCURRENT_USERS=10

# Optional: Remote Database for CI/CD
# CI_DB_HOST=your-ci-database.com
# CI_DB_PORT=3306
# CI_DB_USER=ci_user
# CI_DB_PASSWORD=ci_password
# CI_DB_NAME=sql_training_ci