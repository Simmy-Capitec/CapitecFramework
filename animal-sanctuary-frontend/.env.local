# Animal Sanctuary Frontend Environment Variables

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_API_TIMEOUT=10000

# External API URL (Express server fallback)
EXTERNAL_API_URL=http://localhost:3001

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=password123
DATABASE_NAME=animal_sanctuary_capstone
DATABASE_SSL=false
DATABASE_CONNECTION_LIMIT=10

# Sanctuary Configuration
NEXT_PUBLIC_SANCTUARY_NAME=Paws & Hearts Animal Sanctuary
NEXT_PUBLIC_SANCTUARY_TAGLINE=Where every animal finds their forever home
NEXT_PUBLIC_SANCTUARY_PHONE=(555) 123-PAWS
NEXT_PUBLIC_SANCTUARY_EMAIL=adopt@pawsandhearts.org
NEXT_PUBLIC_SANCTUARY_ADDRESS=123 Sanctuary Lane, Hope Valley, CA 95432

# Feature Flags
NEXT_PUBLIC_ENABLE_ONLINE_APPLICATIONS=true
NEXT_PUBLIC_ENABLE_DONATIONS=true
NEXT_PUBLIC_ENABLE_VOLUNTEER_SIGNUP=true
NEXT_PUBLIC_ENABLE_VIRTUAL_TOURS=false

# Social Media
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/pawsandheartssanctuary
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/pawsandheartssanctuary
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/pawsandhearts

# Development
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1